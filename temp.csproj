<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
  </ItemGroup>

  <Target Name="_UpdatePrunePackageReferences" AfterTargets="AddPrunePackageReferences">
    <ItemGroup>
      <PrunePackageReference Update="System.IO.Pipelines" Version="9.0.0" />
    </ItemGroup>
  </Target>
</Project>
